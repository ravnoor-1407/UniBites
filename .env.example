# UniBite Environment Variables Template

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# Replace with your actual MongoDB Atlas connection URI in .env (never commit .env)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/unibite?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=7d

# Socket.IO & Realtime Configuration
SOCKET_PORT=5000